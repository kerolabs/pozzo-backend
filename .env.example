# Copy this file to .env and fill in the values. .env is ignored by git.
# Supabase: Connect > Connection string > Type: JDBC > Method: Session pooler

DATABASE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=your-database-password

# Signing key of the JWT tokens, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Code delivery: "log" (default, the code goes to the console) or "smsgate" (an Android phone with
# the SMS Gate app sends it from its SIM)
SMS_PROVIDER=log
# Required when SMS_PROVIDER is smsgate: SMS Gate app > Settings > Cloud Server, once it shows "Online"
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Optional: a private SMS Gate server instead of the public one
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1

# Optional demo numbers that always receive SMS_TEST_CODE and no SMS (comma-separated)
SMS_TEST_NUMBERS=
SMS_TEST_CODE=

# Account recovery emails: "log" (default, the email goes to the console) or "brevo"
EMAIL_PROVIDER=log
# Required when EMAIL_PROVIDER is brevo: Brevo > SMTP & API > API keys, and a sender verified in
# Brevo > Senders, domains & dedicated IPs
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Pozzo

# Push notifications: "log" (default, the notification goes to the console) or "fcm"
PUSH_PROVIDER=log
# Required when PUSH_PROVIDER is fcm: Firebase console > Project settings > Service accounts >
# Generate new private key; paste the JSON or its Base64
FCM_SERVICE_ACCOUNT=
